{
  "name": "ione",
  "version": "0.5.87",
  "homepage": "https://github.com/haasele/ione",
  "description": "Ione: Zen Browser's Spaces, Essentials, Glance, Split View and Compact Mode on the Blink engine (Electron on desktop, the system WebView on Android).",
  "main": "./out/main/index.js",
  "desktopName": "ione.desktop",
  "author": "Ione contributors",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "patch-package && electron-builder install-app-deps && install-electron",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:linux:rpm": "electron-vite build && electron-builder --linux rpm --x64",
    "build:linux:flatpak": "electron-vite build && electron-builder --linux flatpak --x64",
    "build:win:msi": "electron-vite build && electron-builder --win msi --x64",
    "build:win:portable": "electron-vite build && electron-builder --win zip --x64",
    "dev:android": "vite -c vite.android.config.ts",
    "build:android:web": "vite build -c vite.android.config.ts && vite build -c vite.android.config.ts --mode page && vite build -c vite.android.config.ts --mode webapp && vite build -c vite.android.config.ts --mode ext && vite build -c vite.android.config.ts --mode ext-janitor && vite build -c vite.android.config.ts --mode pdf",
    "build:android": "bun run build:android:web && cd android && ./gradlew assembleDebug -PskipWeb",
    "build:android:release": "bun run build:android:web && cd android && ./gradlew assembleRelease -PskipWeb",
    "icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/app-icons.ts",
    "blocking:snapshot": "node --experimental-strip-types --no-warnings .github/scripts/build-blocking-snapshot.mts",
    "safebrowsing:snapshot": "node --experimental-strip-types --no-warnings --import ./scripts/ts-imports.mjs scripts/safebrowsing-snapshot.mts",
    "lookalikes:snapshot": "node --experimental-strip-types --no-warnings --import ./scripts/ts-imports.mjs scripts/lookalikes-snapshot.mts",
    "release": "node .github/scripts/cut-release.mjs"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@ghostery/adblocker": "^2.18.2",
    "@mozilla/readability": "^0.6.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fasttext.wasm.js": "^1.0.0",
    "lucide-react": "^1.47.0",
    "mpris-service": "^2.1.2",
    "nayuki-qr-code-generator": "1.8.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "scrypt-js": "3.0.1",
    "tailwind-merge": "^3.7.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "4.13.0",
    "electron": "^44.10.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "patch-package": "8.0.1",
    "playwright": "1.63",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "app-builder-lib": "26.15.3",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "fast-uri": "3.1.9",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "xml2js": "0.5.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
