{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@ione/core": [
        "../../packages/core/src/index.ts"
      ],
      "@ione/rss": [
        "../../packages/rss/src/index.ts"
      ]
    }
