{
  "name": "@ione/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "install:electron": "install-electron",
    "postinstall": "bun run install:electron",
    "perf": "electron-vite build && node scripts/perf.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --dir --publish never --config electron-builder.yml",
    "package:linux": "electron-vite build && electron-builder --linux --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-chrome-context-menu": "1.1.0",
    "@ghostery/adblocker-electron": "2.20.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "electron": "44.9.2",
    "electron-vite": "6.0.0",
    "svelte": "5.57.2",
    "vite": "8.3.4",
    "@playwright/test": "1.64.1",
    "@ione/core": "workspace:*",
    "@ione/ui-kit": "workspace:*",
    "@ione/rss": "workspace:*",
    "electron-builder": "26.15.3"
  },
  "description": "Ione: a Zen-style Electron browser shell"
}
