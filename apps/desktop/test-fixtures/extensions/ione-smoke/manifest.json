{
  "manifest_version": 3,
  "name": "Ione Smoke Extension",
  "version": "1.0.0",
  "description": "Loads in Ione extension smoke tests.",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Ione Smoke Extension",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html" },
  "permissions": ["storage"]
}
